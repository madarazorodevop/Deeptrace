# Express server
PORT=8080
CLIENT_ORIGIN=http://localhost:5173
MAX_FILE_MB=50
MAX_IMAGE_MB=20
MAX_VIDEO_MB=50
MAX_AUDIO_MB=50
MAX_DURATION_SEC=60
RETENTION_MINUTES=60
MAX_CONCURRENT_JOBS=2

# Gemini (server only; explanation is not implemented yet)
GEMINI_API_KEY=
GEMINI_MODEL=

# Local DeepGuard detector service
DETECTOR_MODE=real
DETECTOR_NAME=deepguard_local
DETECTOR_BASE_URL=http://127.0.0.1:8000
DETECTOR_TIMEOUT_MS=300000
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Detector process settings (export in the shell before starting detector/main.py)
# DEEPGUARD_MODEL=ms_eff_gcvit_b0
# DEEPGUARD_DATASET=ff++
# DETECTOR_PORT=8000
# DETECTOR_MAX_IMAGE_MB=20
# DETECTOR_MAX_VIDEO_MB=80
# DETECTOR_MAX_DURATION_SEC=60

# Optional Supabase (server only)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
